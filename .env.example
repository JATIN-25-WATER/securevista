# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, no setup required):
DATABASE_URL=sqlite:///./securevista.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/securevista

# ── Auth ──────────────────────────────────────────────────────────────────────
# Change this in production — any long random string works
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Stream (Phase 2) ──────────────────────────────────────────────────────────
# Blur faces in MJPEG stream output (privacy — no face data stored either way)
BLUR_FACES=true
# JPEG compression quality for stream (1–100)
STREAM_JPEG_QUALITY=75
# Target FPS for MJPEG stream
STREAM_FPS=15

# ── Evidence (Phase 3) ────────────────────────────────────────────────────────
# Directory where evidence clip MP4s are stored
EVIDENCE_DIR=./evidence_clips
