# Dockerfile.frontend — Phase 1 static placeholder (full React app in Phase 5)
FROM nginx:alpine

COPY frontend/public/index.html /usr/share/nginx/html/index.html

RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
